# ── Backend Environment Variables (Railway) ──────────────────────────────────
# 1. Supabase Project URL & Keys (From Supabase Dashboard -> Project Settings -> API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-service-role-or-anon-key

# Optional alias names also supported:
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# SUPABASE_ANON_KEY=your-anon-key

# 2. Allowed CORS Origins (Include your Vercel domain or leave * for all)
ALLOWED_ORIGINS=*
# Or specify: http://localhost:3000,https://civic-catalyst.vercel.app

# 3. Port (Railway injects PORT automatically)
PORT=8000
